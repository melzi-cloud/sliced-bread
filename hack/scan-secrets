#!/usr/bin/env bash
# Fail if any tracked or staged file contains a development secret or a
# credential-shaped string. Prints file names only, never the matched value.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

files=$(git ls-files -co --exclude-standard)
status=0

# Credential-shaped patterns.
if matches=$(grep -lE 'github_pat_[A-Za-z0-9_]{20,}|ghp_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----' $files 2>/dev/null | grep -v '^hack/scan-secrets$' | grep -v '_test.go$'); then
  echo "scan-secrets: credential-shaped strings in:" >&2
  echo "$matches" | sed 's/^/  /' >&2
  status=1
fi

# Exact values from the keychain, when available.
KC="${SB_KEYCHAIN:-$HOME/Library/Keychains/slicedbread-dev.keychain-db}"
if command -v security >/dev/null 2>&1; then
  for item in sb-dev-hcloud sb-dev-cloudflare sb-dev-s3-secret sb-dev-github; do
    v="$(security find-generic-password -a "$USER" -s "$item" -w "$KC" 2>/dev/null || true)"
    [ -z "$v" ] && continue
    if matches=$(grep -lF -- "$v" $files 2>/dev/null); then
      echo "scan-secrets: value of $item found in:" >&2
      echo "$matches" | sed 's/^/  /' >&2
      status=1
    fi
  done
  unset v
fi

[ $status -eq 0 ] && echo "scan-secrets: clean"
exit $status
