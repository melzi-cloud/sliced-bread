#!/usr/bin/env bash
# Run a command with development secrets in its environment.
#
#   hack/secrets-env go run ./hack/sb-dev tenant list
#
# Secrets come from the slicedbread-dev macOS keychain. If they are already set
# in the environment (CI), the keychain is not touched. This script never prints
# secret values. Non-secret settings come from dev.env (gitignored).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$ROOT/dev.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/dev.env"
  set +a
fi

if [ $# -eq 0 ]; then
  echo "usage: hack/secrets-env <command> [args...]" >&2
  exit 2
fi

if [ -z "${HCLOUD_TOKEN:-}" ] || [ -z "${CF_API_TOKEN:-}" ] || [ -z "${CF_ACCOUNT_ID:-}" ]; then
  if ! command -v security >/dev/null 2>&1; then
    echo "secrets-env: HCLOUD_TOKEN, CF_API_TOKEN and CF_ACCOUNT_ID must be set (no macOS keychain here)" >&2
    exit 3
  fi
  KC="${SB_KEYCHAIN:-$HOME/Library/Keychains/slicedbread-dev.keychain-db}"
  read_secret() { security find-generic-password -a "$USER" -s "$1" -w "$KC" 2>/dev/null; }
  if ! read_secret sb-dev-hcloud >/dev/null; then
    echo "secrets-env: cannot read the slicedbread-dev keychain (locked or missing)." >&2
    echo "  Unlock it in the same session the agent runs in:" >&2
    echo "  security unlock-keychain \"$KC\"" >&2
    exit 3
  fi
  HCLOUD_TOKEN="$(read_secret sb-dev-hcloud)"
  CF_API_TOKEN="$(read_secret sb-dev-cloudflare)"
  CF_ACCOUNT_ID="$(read_secret sb-dev-cloudflare-id)"
  SB_S3_ACCESS_KEY="$(read_secret sb-dev-s3-key || true)"
  SB_S3_SECRET_KEY="$(read_secret sb-dev-s3-secret || true)"
  export HCLOUD_TOKEN CF_API_TOKEN CF_ACCOUNT_ID SB_S3_ACCESS_KEY SB_S3_SECRET_KEY
fi

exec "$@"
